+constexpr int ProgressiveTileSize = 64;
+// below this a band costs more in pdu and wakeup overhead than it saves in encoding time
+constexpr int MinTilesPerBand = 32;
+constexpr int DefaultEncoderThreads = 4;
+
+int encoderThreadCount()
+{
+    static const int count = [] {
+        bool ok = false;
+        const int value = qEnvironmentVariableIntValue("KRDP_ENCODER_THREADS", &ok);
+        return ok ? std::clamp(value, 1, 16) : DefaultEncoderThreads;
+    }();
+    return count;
+}
