+// Reads back only \a region of the texture, the rest of \a target keeps its contents
+static void grabTexture(GLTexture *texture, QImage *target, const Region &region)
+{
+    const Rect bounds(QPoint(), texture->size());
+    const Region clipped = region & bounds;
+    if (clipped.isEmpty()) {
+        return;
+    }
+    // every read is a synchronous round trip, many tiny rects would cost more than they save
+    if (clipped.rects().size() > 32 || clipped.boundingRect() == bounds) {
+        grabTexture(texture, target);
+        return;
+    }
+    EglContext *context = EglContext::currentContext();
+
+    texture->bind();
+    GLFramebuffer fbo(texture);
+    context->pushFramebuffer(&fbo);
+    glPixelStorei(GL_PACK_ROW_LENGTH, target->bytesPerLine() / (target->depth() / 8));
+    for (const Rect &rect : clipped.rects()) {
+        glPixelStorei(GL_PACK_SKIP_PIXELS, rect.x());
+        glPixelStorei(GL_PACK_SKIP_ROWS, rect.y());
+        context->glReadnPixels(rect.x(), rect.y(), rect.width(), rect.height(), closestGLType(target->format()), GL_UNSIGNED_BYTE, target->sizeInBytes(), target->bits());
+    }
+    glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
+    glPixelStorei(GL_PACK_SKIP_ROWS, 0);
+    context->popFramebuffer();
+}
