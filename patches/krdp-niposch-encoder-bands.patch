+// Tile rows with roughly equal damage per band. Bands only ever start on a tile row, so no tile
+// is shared and each one can go through its own context as a self-contained progressive message.
+std::vector<int> progressiveBandEdges(const REGION16 *region, int height, int maxBands)
+{
+    std::vector<int> rowTiles((height + ProgressiveTileSize - 1) / ProgressiveTileSize, 0);
+    UINT32 rectCount = 0;
+    const RECTANGLE_16 *rects = region16_rects(region, &rectCount);
+    int totalTiles = 0;
+    for (UINT32 i = 0; i < rectCount; ++i) {
+        const int tiles = (rects[i].right - 1) / ProgressiveTileSize - rects[i].left / ProgressiveTileSize + 1;
+        for (int row = rects[i].top / ProgressiveTileSize; row <= (rects[i].bottom - 1) / ProgressiveTileSize; ++row) {
+            rowTiles[row] += tiles;
+            totalTiles += tiles;
+        }
+    }
+
+    const int bandCount = std::clamp(totalTiles / MinTilesPerBand, 1, maxBands);
+    std::vector<int> edges{0};
+    int seenTiles = 0;
+    for (size_t row = 0; row + 1 < rowTiles.size() && int(edges.size()) < bandCount; ++row) {
+        seenTiles += rowTiles[row];
+        if (seenTiles * bandCount >= totalTiles * int(edges.size())) {
+            edges.push_back(int(row + 1) * ProgressiveTileSize);
+        }
+    }
+    edges.push_back(height);
+    return edges;
+}
